# Postgres databáze (Neon). Na Vercelu ji nastaví integrace Neon automaticky.
# Lokálně bez ní běží vestavěná databáze PGlite ve složce .pglite.
DATABASE_URL=

# Náhodný řetězec pro podpis přihlášení do administrace (min. 32 znaků)
SESSION_SECRET=

# Klíč pro vytvoření prvního administrátora na /admin/setup
SETUP_KEY=

# SMTP pro potvrzovací e-maily (Seznam). Bez nich se e-maily jen vypíšou do konzole.
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.seznam.cz
# SMTP_PORT=465

# Volitelně pevná adresa webu pro odkazy v e-mailech (jinak se zjistí z požadavku)
# APP_BASE_URL=https://pizzerie.dbrvsk.cz
